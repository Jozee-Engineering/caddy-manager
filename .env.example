# Copy to .env and adjust for your setup, then `docker compose up -d`.

# Host path to the Caddyfile your running Caddy already uses (must exist):
CADDYFILE_HOST_PATH=/etc/caddy/Caddyfile

# The external docker network your Caddy container is attached to:
CADDY_NETWORK=caddy_default

# Optional: set BOTH to skip the onboarding screen and use fixed credentials.
# UI_USER=admin
# UI_PASS=change-me
