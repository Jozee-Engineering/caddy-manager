{
  "config": {
    "base_domain": "example.com",
    "global_lines": [
      "email you@example.com",
      "acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}",
      "admin :2019"
    ]
  },
  "routes": [
    {
      "id": "app",
      "label": "Example app",
      "subdomain": "app",
      "upstream": "192.168.1.50:3000",
      "before_proxy": "",
      "proxy_headers": "header_up X-Real-IP {remote_host}",
      "enabled": true
    }
  ]
}
